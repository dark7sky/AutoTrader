# Put real values only in your local .env, never in this example file or git history.
TRADING_MODE=shadow
LIVE_TRADING_ENABLED=false
KIS_ENV=demo

# KIS paper/demo trading app credentials.
KIS_DEMO_APP_KEY=
KIS_DEMO_APP_SECRET=
KIS_DEMO_ACCOUNT_NO=
KIS_DEMO_ACCOUNT_PRODUCT_CODE=01

# KIS real trading app credentials. Use only after demo BUY/SELL is verified.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_ACCOUNT_PRODUCT_CODE=01

# Telegram operator control is optional; keep the bot restricted to one chat.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_ID=
# AI auto-trading decisions use this when auto-trade-cycle --ai openai is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI organization cost reporting. Use an admin key here.
# OPENAI_ADMIN_KEY=
# Or use this alias if you want to keep the usage key name separate.
# OPENAI_USAGE_API_KEY=
AUTO_TRADE_CYCLE_INTERVAL_SECONDS=60
# Optional HTS id metadata. Do not put app keys or secrets here.
# KIS_HTS_ID=
