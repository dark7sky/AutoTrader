# Put real values only in your local .env, never in this example file or git history.
LIVE_TRADING_ENABLED=false
# Default target for smoke and one-shot CLI commands. The long-running
# service stores its selected demo/real environment in SQLite.
KIS_ENV=demo

# KIS paper/demo trading app credentials.
KIS_DEMO_APP_KEY=
KIS_DEMO_APP_SECRET=
KIS_DEMO_ACCOUNT_NO=
KIS_DEMO_ACCOUNT_PRODUCT_CODE=01

# KIS real trading app credentials. Use only after demo BUY/SELL is verified.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_ACCOUNT_PRODUCT_CODE=01

# Telegram operator control is optional; keep the bot restricted to one chat.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_ID=
# Optional Telegram user id. Required for group/supergroup commands; also narrows private-chat access.
# TELEGRAM_ALLOWED_USER_ID=
# AI auto-trading decisions use this when auto-trade-cycle --ai openai is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI organization cost reporting. Use an admin key here.
# OPENAI_ADMIN_KEY=
# Or use this alias if you want to keep the usage key name separate.
# OPENAI_USAGE_API_KEY=

# AI call and cost guardrails. These are conservative local defaults.
OPENAI_MAX_PROCESS_CALLS=500
OPENAI_MAX_DAILY_CALLS=1000
OPENAI_MAX_PROCESS_COST_USD=10.0
OPENAI_MAX_DAILY_COST_USD=25.0
OPENAI_MAX_RESPONSE_AGE_SECONDS=20
OPENAI_TIMEOUT_SECONDS=8
OPENAI_MAX_RETRIES=1

# Strategy sizing and risk guardrails.
AUTO_TRADE_AI=openai
AUTO_TRADE_MAX_QUANTITY=1
AUTO_TRADE_DECISION_DEADLINE_SECONDS=25
AUTO_TRADE_ALLOCATED_KRW=3000000
RISK_PER_TRADE_PCT=0.3
MAX_POSITION_PCT=10
MAX_TOTAL_EXPOSURE_PCT=20
MAX_POSITIONS=2
MAX_DAILY_LOSS_PCT=1.0
CONSECUTIVE_LOSS_LIMIT=3
MAX_TRADES_PER_DAY=10
MAX_ORDERS_PER_SYMBOL=3
AI_MIN_CONFIDENCE=0.75

# Service and market data operation settings.
AUTO_TRADE_COLLECT_SECONDS=10
AUTO_TRADE_CYCLE_INTERVAL_SECONDS=20
SERVICE_HEARTBEAT_MAX_AGE_SECONDS=180
MARKET_TICK_RETENTION_DAYS=7
MARKET_BAR_RETENTION_DAYS=365
BUY_ORDER_TTL_SECONDS=60
SELL_ORDER_TTL_SECONDS=30
ORDER_SUPERVISOR_INTERVAL_SECONDS=5
# Portainer/production can override this. The local default remains ./data.
DATA_DIR=./data
# KIS HTS user id used by realtime fill notifications. REST reconciliation
# remains available when omitted, but production operation should set it.
# KIS_HTS_ID=
